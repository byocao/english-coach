{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "english-coach",
  "account_id": "f330997b66e28a6012d7e1f5a2d5485e",
  "main": "worker/index.ts",
  "workers_dev": true,
  // Production address. byocao.com is a zone in this Cloudflare account; Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "wancha.byocao.com", "custom_domain": true }],
  "preview_urls": false,
  "compatibility_date": "2026-10-15",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  // Workers AI: Whisper for speech-to-text, Llama for trial users' grading.
  "ai": { "binding": "AI", "remote": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "english-coach",
      "database_id": "854284b8-9d5f-4b6b-8c49-8e5a1c82a56d",
      "migrations_dir": "migrations"
    }
  ],
  // The BridgeHub Durable Object (local Claude CLI bridge) is gone; v2 deletes it.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BridgeHub"] },
    { "tag": "v2", "deleted_classes": ["BridgeHub"] }
  ],
  "vars": {
    "CONTACT_URL": "https://github.com/byocao",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Claude API (secret ANTHROPIC_API_KEY): custom lessons on Opus, speaking grades on Haiku.
    "LESSON_MODEL": "claude-opus-5-5",
    "GRADE_MODEL": "claude-haiku-5-5",
    // Per account, except the admin (unlimited). Only VIP and admin accounts write lessons.
    "GRADE_LIMIT": "10",
    "VIP_LESSON_LIMIT": "10",
    "VIP_GRADE_LIMIT": "100",
    // Classes (VIP and admin only): classes per VIP, students and co-teachers per class.
    "CLASS_LIMIT": "3",
    "CLASS_STUDENT_LIMIT": "15",
    "CLASS_TEACHER_LIMIT": "1",
    // Once a month's Claude spend reaches this, lesson creation and grading show "đang bảo trì".
    "MONTHLY_BUDGET_USD": "70"
  },
  "observability": { "enabled": true }
}
