{
  "name": "english-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply english-coach --local",
    "db:migrate:remote": "wrangler d1 migrations apply english-coach --remote",
    "deploy": "npm run build && wrangler deploy",
    "prebuild": "node scripts/fetch-live2d.mjs",
    "predev": "node scripts/fetch-live2d.mjs",
    "seed:check": "node scripts/check-seed.mjs",
    "seed:build": "node scripts/check-seed.mjs && node scripts/build-seed.mjs",
    "db:seed:local": "npm run seed:build && wrangler d1 execute english-coach --local --file seed/course.sql",
    "db:seed:remote": "npm run seed:build && wrangler d1 execute english-coach --remote --file seed/course.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "hono": "4.13.14",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "^6.5.10",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261029.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.155.0"
  }
}
